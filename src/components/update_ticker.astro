---
// TODO: creare contenitore per sta roba
import { lastUpdatesData } from '../content/static_pages/lastUpdates.ts';

---
<!-- Wrapper esterno -->
<div class="overflow-hidden">
  
  <div class="ticker-track flex gap-8 flex-1">
    
    <!-- Renderizziamo gli stessi dati 2 volte per coprire lo schermo e creare il loop -->
    {[...lastUpdatesData, ...lastUpdatesData,].map((item) => (
      <div class="flex items-center gap-3 whitespace-nowrap">
        <span class="text-xs text-gray-500">{item.date}</span>
        <span class="font-bold text-xs px-1">{item.type}</span>
        <span class="text-sm">{item.text}</span>
      </div>
    ))}

  </div>
</div>

<style>
  .ticker-track {
    animation: scroll 30s linear infinite;
  }

  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-60%); } 
  }
</style>

